# Talos Cloud — Credit & Billing Control Plane
#
# This service is the authoritative source of truth for:
#   - Account balances and device-bound auth tokens
#   - The Talos Relay (all provider API calls route through here)
#   - Credit ledger and transaction history
#   - Pricing engine and margin monitoring
#   - Dashboard API
#   - Stripe billing integration
#
# Key invariants enforced here — violating any is a critical bug:
#   1. Real provider API keys (Anthropic, Tavily, etc.) are ONLY used server-side
#      in relay_service.py. They are never sent to or derivable by local clients.
#   2. The `provider` field in pricing_events is INTERNAL ONLY — never appears
#      in any HTTP response body sent to a client.
#   3. Balance check-and-debit is a single atomic SQL statement (UPDATE...WHERE).
#   4. No account can ever be overdrafted.
#   5. Pricing changes are manual-only; margin_monitor.py alerts humans, never
#      auto-publishes a new pricing_version.

DATABASE_URL=postgresql+asyncpg://talos:talosdev@localhost:5432/talos_cloud
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_MINUTES=60
TALOS_ENV=development

# Redis Configuration (Used for rate limiting, locks, and cache — not Celery)
# Local Development:
# REDIS_URL=redis://localhost:6379/0
# Production (Upstash Redis with TLS):
REDIS_URL=rediss://default:<YOUR_UPSTASH_PASSWORD>@<YOUR_UPSTASH_HOST>:6379
# Optional override (falls back to REDIS_URL):
# REDIS_CORE_URL=rediss://default:<YOUR_UPSTASH_PASSWORD>@<YOUR_UPSTASH_HOST>:6379

# Inngest Background Jobs & Workflow Engine Configuration
# Production (Set via your deployment secret manager):
# INNGEST_EVENT_KEY=your-production-inngest-event-key
# INNGEST_SIGNING_KEY=signkey-prod-your-inngest-signing-key
# Local Development with Inngest Dev Server (connects to local dev server at 127.0.0.1:8288):
# INNGEST_DEV=1


# Real provider keys — server-side only, never sent to clients
# ANTHROPIC_API_KEY=...
# TAVILY_API_KEY=...
# GROQ_API_KEY=...

# Stripe (Phase 8)
# STRIPE_SECRET_KEY=...
# STRIPE_WEBHOOK_SECRET=...

# Tigris S3-compatible Object Storage (Server-Side Only - Never expose to client)
# TIGRIS_ACCESS_KEY_ID=
# TIGRIS_SECRET_ACCESS_KEY=
# TIGRIS_ENDPOINT_URL=https://t3.storage.dev
# TIGRIS_REGION=auto
# TIGRIS_BUCKET_NAME=talos-marketplace
